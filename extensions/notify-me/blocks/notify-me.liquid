{% comment %}
  Renders on any product that has a sold-out variant, and hides itself via
  [hidden] when the selected variant is in stock. The availability of every
  variant is passed to the JS so switching variants toggles the block without a
  page load. The inline footprint is a single trigger button; the signup form
  lives in a native <dialog> that opens as a popup. Inherits theme typography;
  merchants control copy, colors and sizes from the app's Widget design page,
  which saves them to an app-data metafield (see app/widget.ts).
{% endcomment %}

{%- liquid
  assign w = app.metafields.notify_me.widget.value
  # Lines the merchant can clear to hide. Before the first save, use the defaults.
  if w == blank
    assign eyebrow = 'Restock notice'
    assign subheading = "We'll let you know the moment it's back in stock."
    assign fine_print = 'One email when this item returns. Not a marketing list.'
  else
    assign eyebrow = w.eyebrow
    assign subheading = w.subheading
    assign fine_print = w.finePrint
  endif
-%}

{% assign sold_out_count = product.variants | where: "available", false | size %}
{%- comment -%}
  In the theme editor it always renders, so a merchant placing the block on an
  in-stock product sees what they added instead of an empty slot.
{%- endcomment -%}
{% if sold_out_count > 0 or request.design_mode %}
  {% capture variant_availability %}
    {%- for variant in product.variants -%}
      {{- variant.id }}:{% if variant.available %}1{% else %}0{% endif %}{% unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  {% endcapture %}
  <div
    class="notify-me"
    data-notify-me
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-variant-availability="{{ variant_availability | strip }}"
    data-proxy="/apps/notify-me"
    data-success-text="{{ w.successHeading | default: "You're on the list" | escape }}"
    data-invalid-text="{{ w.invalidText | default: 'Enter a valid email address.' | escape }}"
    data-error-text="{{ w.errorText | default: 'Something went wrong. Try again.' | escape }}"
    style="{{ w.style | escape }}"
    {% if product.selected_or_first_available_variant.available %}{% unless request.design_mode %}hidden{% endunless %}{% endif %}
  >
    <button
      type="button"
      class="notify-me__trigger"
      data-notify-me-trigger
      data-default-text="{{ w.buttonText | default: 'Notify me when available' | escape }}"
      aria-haspopup="dialog"
    >
      {{ w.buttonText | default: 'Notify me when available' | escape }}
    </button>

    <dialog
      class="notify-me__dialog"
      data-notify-me-dialog
      aria-labelledby="notify-me-title-{{ block.id }}"
    >
      <div class="notify-me__panel">
        <button type="button" class="notify-me__close" data-notify-me-close aria-label="Close">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="m5 5 10 10M15 5 5 15"></path>
          </svg>
        </button>

        <div class="notify-me__product">
          {% if product.featured_image and w.showImage != false %}
            {{
              product.featured_image
              | image_url: width: 160
              | image_tag: class: 'notify-me__thumb', alt: '', loading: 'lazy', width: 80, height: 80
            }}
          {% endif %}
          <div class="notify-me__product-text">
            {% if eyebrow != blank %}
              <p class="notify-me__eyebrow">{{ eyebrow | escape }}</p>
            {% endif %}
            <p class="notify-me__product-title">{{ product.title | escape }}</p>
          </div>
        </div>

        <form data-notify-me-form novalidate>
          <h2 class="notify-me__heading" id="notify-me-title-{{ block.id }}">{{ w.heading | default: 'Email me when this is back' | escape }}</h2>
          {% if subheading != blank %}
            <p class="notify-me__subheading">{{ subheading | escape }}</p>
          {% endif %}

          {%- comment -%} Honeypot: hidden from people, filled by bots, rejected server-side. {%- endcomment -%}
          <input class="notify-me__hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">

          {%- comment -%}
            Several sold-out variants: let the shopper pick one here without
            closing the popup. One sold-out variant: just name it.
          {%- endcomment -%}
          {% unless product.has_only_default_variant %}
            {% if sold_out_count > 1 %}
              <div class="notify-me__group">
                <label class="notify-me__label" for="notify-me-variant-{{ block.id }}">{{ w.variantLabel | default: 'Option' | escape }}</label>
                <div class="notify-me__select-wrap">
                  <select id="notify-me-variant-{{ block.id }}" class="notify-me__control notify-me__select" data-notify-me-variant>
                    {% for variant in product.variants %}
                      {% unless variant.available %}
                        <option value="{{ variant.id }}">{{ variant.title | escape }}</option>
                      {% endunless %}
                    {% endfor %}
                  </select>
                </div>
              </div>
            {% else %}
              {% assign sold_out_variant = product.variants | where: "available", false | first %}
              <p class="notify-me__variant-name">{{ sold_out_variant.title | escape }}</p>
            {% endif %}
          {% endunless %}

          <div class="notify-me__group">
            <label class="notify-me__label" for="notify-me-email-{{ block.id }}">{{ w.emailLabel | default: 'Email address' | escape }}</label>
            <input
              id="notify-me-email-{{ block.id }}"
              class="notify-me__control"
              type="email"
              name="email"
              required
              autofocus
              autocomplete="email"
              placeholder="{{ w.placeholder | default: 'you@example.com' | escape }}"
              aria-describedby="notify-me-message-{{ block.id }}"
            >
          </div>

          <p
            id="notify-me-message-{{ block.id }}"
            class="notify-me__message"
            data-notify-me-message
            role="status"
            aria-live="polite"
          ></p>

          <button class="notify-me__button" type="submit" data-notify-me-button>
            <span class="notify-me__button-label">{{ w.submitText | default: 'Notify me' | escape }}</span>
            <span class="notify-me__spinner" aria-hidden="true"></span>
          </button>

          <p class="notify-me__fine-print">
            {{ fine_print | escape }}
            {% if w.privacyUrl != blank %}
              <a class="notify-me__link" href="{{ w.privacyUrl | escape }}" target="_blank" rel="noopener">Privacy policy</a>
            {% endif %}
          </p>
        </form>

        <div class="notify-me__success" data-notify-me-success hidden>
          <span class="notify-me__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 12.5 4 4 8-9"></path>
            </svg>
          </span>
          <p class="notify-me__heading">{{ w.successHeading | default: "You're on the list" | escape }}</p>
          <p class="notify-me__subheading">{{ w.successDetail | default: "We'll send one email the moment it's back in stock." | escape }}</p>
          <button type="button" class="notify-me__button" data-notify-me-close>{{ w.doneText | default: 'Done' | escape }}</button>
        </div>
      </div>
    </dialog>
  </div>
{% endif %}

{% schema %}
{
  "name": "Notify me",
  "target": "section",
  "stylesheet": "notify-me.css",
  "javascript": "notify-me.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Customize the button and popup in the BackSoon app, under Widget design."
    }
  ]
}
{% endschema %}
