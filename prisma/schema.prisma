// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model RestockSubscription {
  id             String    @id @default(cuid())
  shop           String
  productId      String
  variantId      String
  // AES-256-GCM ciphertext (see app/crypto.server.ts), never the plain address.
  email          String
  // Keyed HMAC of the lowercased address, for lookups and the unique constraint.
  // Null only on rows saved before encryption, until the boot backfill runs.
  emailHash      String?
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  // When a sender claimed the row (status SENDING); lets a stale claim be retried.
  claimedAt      DateTime?
  unsubscribedAt DateTime?
  // First click on the email's Shop now link (routes/c.$id.tsx).
  clickedAt      DateTime?
  // An order for this variant by the same email within 7 days of the alert
  // (routes/webhooks.orders.create.tsx). orderValue is that line's price x quantity.
  orderId        String?
  orderValue     Decimal?  @db.Decimal(12, 2)
  orderCurrency  String?
  orderedAt      DateTime?

  // One live request per shopper per variant; re-subscribing after a send reuses the row.
  @@unique([shop, variantId, emailHash])
  @@index([shop, variantId, status])
}

model ShopSettings {
  shop        String   @id
  emailSubject String  @default("{{product}} is back in stock")
  fromName    String   @default("")
  testSentAt  DateTime?
  setupDismissedAt DateTime?
  reviewPromptDismissedAt DateTime?
  // Billing (app/plans.server.ts): the Partner API plan, cached.
  plan          String    @default("free")
  planCheckedAt DateTime?
  shopGid       String?
  // Installed before paid plans launched: Starter stays free.
  grandfathered Boolean   @default(false)
  // Restock emails sent in usageMonth ("2026-11"), counted against the plan.
  usageMonth    String    @default("")
  usageCount    Int       @default(0)
  // Growth: email every restock, not just the first.
  renotify      Boolean   @default(false)
  // Growth: email design. Empty means the built-in default.
  emailButtonColor String @default("")
  emailLogoUrl     String @default("")
  // Shopper-facing email and unsubscribe page words; see app/email-text.ts.
  emailText   Json?
  // Unused: from the Billing API plans that were reverted (1d188b4). Kept so the schema matches prod.
  trialUsedAt DateTime?
  updatedAt   DateTime @updatedAt
}

// Who read shopper emails, and how. Kept for a year (app/retention.server.ts).
model DataAccessLog {
  id        String   @id @default(cuid())
  shop      String
  // csv_export, data_request
  action    String
  // Shopify staff user ID from the session token, when a person did it.
  userId    String?
  records   Int
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
